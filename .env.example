# ORVEXA local development configuration
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Database (development only; replace before use)
POSTGRES_DB=orvexa
POSTGRES_USER=orvexa
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://orvexa:change-me-in-local-env@localhost:5432/orvexa

# Authentication secrets are placeholders only. Replace them through a local .env
# file or secret manager; never commit real values.
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_ATTEMPTS=10
DOCUMENT_STORAGE_ROOT=storage/documents
DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
