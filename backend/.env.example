APP_ENV=development
JWT_ALGORITHM=HS256
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this in the backend environment; do not commit the generated value.
JWT_SECRET_KEY=

# Document analysis is disabled unless a provider is explicitly configured.
ANALYSIS_PROVIDER=unavailable
# Set these only in the backend environment; never put provider credentials in Flutter.
# ANALYSIS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_MAX_INPUT_CHARACTERS=120000
ANALYSIS_RETRY_ATTEMPTS=2
